# it-landscape — modèle de configuration
# Copier en .env (Docker) ou .env.local (développement). Ne jamais versionner les fichiers remplis.

###############################################################################
# Authentification
###############################################################################
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-local-dev-secret-at-least-32-chars
AUTH_ENABLED=true
# Production : active les contrôles de démarrage
# IT_LANDSCAPE_ENV=production

# Entra ID / Azure AD (facultatif)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

###############################################################################
# Source NetBox (sans ces deux variables : jeu de démonstration)
###############################################################################
# NETBOX_URL=http://netbox.interne:8000
# NETBOX_TOKEN=jeton-en-lecture-seule
# Adresse utilisée pour les liens « Ouvrir dans NetBox » (par défaut : NETBOX_URL)
# NETBOX_PUBLIC_URL=https://netbox.example.org
# Durée du cache serveur en secondes (défaut 120)
# LANDSCAPE_CACHE_SECONDS=120

###############################################################################
# Habillage (lu au build)
###############################################################################
NEXT_PUBLIC_LOGO_URL=/it-landscape-logo.png
NEXT_PUBLIC_ORG_NAME=Organisation de démonstration
NEXT_PUBLIC_APP_TITLE=Cartographie du Système d'Information
