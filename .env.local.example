# Développement local (copié en .env.local par `npm run dev` s'il n'existe pas).
# Voir .env.example pour la liste complète.
NEXTAUTH_SECRET=change_me_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000
AUTH_ENABLED=true

# Brancher un NetBox (sinon : jeu de démonstration)
# NETBOX_URL=http://localhost:8000
# NETBOX_TOKEN=jeton-en-lecture-seule
# NETBOX_PUBLIC_URL=

# NEXT_PUBLIC_LOGO_URL=/it-landscape-logo.png
# NEXT_PUBLIC_ORG_NAME=Mon organisation
# NEXT_PUBLIC_APP_TITLE=Cartographie du Système d'Information
